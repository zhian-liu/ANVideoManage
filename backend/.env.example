# 复制为 .env 并按需修改

# JWT 密钥（生产环境务必改成随机长字符串）
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 数据库（MVP 用 SQLite，改 PostgreSQL 只需换下面这行 + 装 psycopg/asyncpg）
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# 首次启动时创建的默认管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ZLMediaKit REST API（secret 为空表示无鉴权）
ZLM_API_BASE=http://127.0.0.1:8080
ZLM_API_SECRET=
ZLM_APP=live
# 对外播放的 HTTP 端口（即 ZLMediaKit 的 http.port）
ZLM_HTTP_PORT=8080
# 对外播放的 RTSP/RTMP 端口（即 ZLMediaKit 的 rtsp.port / rtmp.port）
ZLM_RTSP_PORT=554
ZLM_RTMP_PORT=1935

# 国标 C++ 服务（平台 SIP/媒体参数在“国标接入”页保存；默认不启用）
# 留空自动查找 native/gb28181/build/bin/Release/gb28181-sip.exe 或安装包 gb28181 目录
GB28181_BINARY=
GB28181_HTTP_PORT=18081
GB28181_RUNTIME_DIR=./data/gb28181

# 文件存储（可在前端“设置”页修改；录像为空时沿用 ZLMediaKit 原目录）
RECORDING_PATH=
SNAPSHOT_PATH=./data/snapshots

# 后端自身地址（供 ZLMediaKit WebHook 回调）
WEBHOOK_BASE=http://127.0.0.1:8000

# Sentry 崩溃上报（留空表示关闭）
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
